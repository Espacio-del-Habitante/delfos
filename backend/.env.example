# Copia este archivo a .env y ajusta los valores.
# Lista modelos instalados: curl http://127.0.0.1:11434/api/tags

# Ollama — modelo local
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# OCR de capturas de broker (por defecto llava). Para mejor precisión en pantallazos:
# OLLAMA_VISION_MODEL=llama3.2-vision
# OLLAMA_VISION_MODEL=qwen2-vl
# OLLAMA_VISION_MODEL=llava

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true
