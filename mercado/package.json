    "check": "node src/lib/parseUtterance.check.mjs && node src/lib/categories.check.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "^8.1.2",
    "astro": "^6.4.7",
    "svelte": "^5.56.3",
    "typescript": "^6.0.3"
  }
}
