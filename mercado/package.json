{
  "name": "delfos-mercado",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "vendor:delfos": "node scripts/vendor-delfos-ui.mjs",
    "dev": "npm run vendor:delfos && astro dev --host 127.0.0.1 --port 5173",
