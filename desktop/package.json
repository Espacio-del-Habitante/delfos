{
  "name": "delfos-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "Desktop shell (Electron) para Delfos",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:frontend": "npm --prefix ../frontend run build",
    "build:backend:binary": "node ./scripts/build-backend.mjs",
    "pack": "npm run build:frontend && npm run build:backend:binary && electron-builder --dir",
    "dist": "npm run build:frontend && npm run build:backend:binary && electron-builder",
    "dist:win": "npm run build:frontend && npm run build:backend:binary && electron-builder --win nsis portable",
    "dist:linux": "npm run build:frontend && npm run build:backend:binary && electron-builder --linux AppImage",
    "dist:mac": "npm run build:frontend && npm run build:backend:binary && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.delfos.desktop",
    "productName": "Delfos",
    "directories": {
      "output": "dist"
    },
    "icon": "../frontend/public/isotipo.png",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/",
        "to": "backend",
        "filter": [
          "delfos-backend",
          "delfos-backend.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    }
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12"
  }
}
